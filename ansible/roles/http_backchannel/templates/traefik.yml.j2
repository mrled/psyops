---
# Traefik configuration for HTTP backchannel

global:
  checkNewVersion: false
  sendAnonymousUsage: false

api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ http_backchannel_acme_email }}
      storage: {{ http_backchannel_config_dir }}/acme.json
      # caServer: https://acme-staging-v02.api.letsencrypt.org/directory
      dnsChallenge:
        provider: route53
        delayBeforeCheck: 30
        # Use public recursive resolvers for zone detection and the
        # propagation check. The host's stub resolver (systemd-resolved /
        # Tailscale MagicDNS) returns empty NOERROR for SOA queries, which
        # breaks lego's FindZoneByFqdn ("could not find zone for FQDN ...").
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"

providers:
  file:
    directory: {{ http_backchannel_config_dir }}/dynamic
    watch: true

log:
  level: {{ http_backchannel_log_level }}
  filePath: /var/log/traefik.log

accessLog:
  filePath: /var/log/traefik-access.log
