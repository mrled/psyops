---
# Dynamic configuration for subdomain to port routing
# Routes subdomains to localhost ports

http:
  routers:
{% for subdomain in http_backchannel_subdomains %}
    {{ subdomain }}-router:
      rule: "Host(`{{ subdomain }}.{{ http_backchannel_dnsname }}`)"
      entryPoints:
        - websecure
      service: {{ subdomain }}-service
      tls:
        certResolver: letsencrypt
{% endfor %}

  services:
{% for subdomain, config in http_backchannel_subdomains.items() %}
    {{ subdomain }}-service:
      loadBalancer:
{% if config.passHostHeader is defined %}
        passHostHeader: {{ config.passHostHeader | bool | lower }}
{% endif %}
        servers:
          - url: "http://127.0.0.1:{{ config.port }}"
{% endfor %}
