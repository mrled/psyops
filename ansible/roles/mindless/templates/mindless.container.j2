[Unit]
Description=Mindless developer container
BindsTo=mindless-firewall.service
After=mindless-firewall.service

[Container]
Image={{ mindless_image }}
Pull=never
ContainerName=mindless
UserNS=auto:size=65536
PodmanArgs=--systemd=always
Network=slirp4netns:allow_host_loopback=false
{% for server in mindless_dns_servers %}
DNS={{ server }}
{% endfor %}
# auto may choose a different mapping when the container is recreated.
Volume=mindless-workspace:/workspace:U
Volume=/etc/mindless/config:/etc/mindless/config:ro
{% if mindless_1password_service_account_token | length > 0 %}
Secret=mindless-1password-service-account-token,target=/etc/mindless/secrets/1password-service-account-token,uid={{ mindless_container_uid }},gid={{ mindless_container_gid }},mode=0400
{% endif %}

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=default.target
