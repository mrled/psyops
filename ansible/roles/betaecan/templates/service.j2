# Managed by Ansible: betaecan
[Unit]
Description=Restic backup for {{ betaecan_user }} ({{ betaecan_job.name }})
{% for path, options in betaecan_job.paths.items() %}
{% if options is mapping and options.mountpoint | default(false) %}
ConditionPathIsMountPoint={{ path }}
{% endif %}
{% endfor %}

[Service]
Type=oneshot
UMask=0077
Environment="HOME={{ betaecan_home }}"
ExecStart={{ betaecan_home }}/.local/bin/betaecanjob "{{ betaecan_job_directory }}" backup
TimeoutStartSec=infinity
NoNewPrivileges=true
