# Managed by Ansible: betaecan
[Unit]
Description=Schedule restic backup for {{ betaecan_user }} ({{ betaecan_job.name }})

[Timer]
OnCalendar={{ betaecan_job.oncalendar | replace('%', '%%') }}
Persistent=true
RandomizedDelaySec={{ betaecan_randomized_delay_sec }}
Unit={{ betaecan_unit }}.service

[Install]
WantedBy=timers.target
