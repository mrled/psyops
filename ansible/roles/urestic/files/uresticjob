#!/bin/sh
# Installed by the urestic Ansible role.
# Credentials are read only from the private runtime cache.
set -eu
job_directory=$1
shift
job=$(basename "$job_directory")
cache="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/urestic/$job"
for credential in restic.password aws.access-key-id aws.secret-access-key; do
    if [ ! -r "$cache/$credential" ]; then
        printf 'urestic: credentials locked; run uresticcache unlock "%s"\n' "$job" >&2
        exit 1
    fi
done
aws_access_key_id=$(cat "$cache/aws.access-key-id")
aws_secret_access_key=$(cat "$cache/aws.secret-access-key")
repository=$(cat "$job_directory/restic.repository")
export RESTIC_PASSWORD_FILE="$cache/restic.password"
export AWS_ACCESS_KEY_ID="$aws_access_key_id"
export AWS_SECRET_ACCESS_KEY="$aws_secret_access_key"
export RESTIC_REPOSITORY="$repository"

if [ "${1:-}" = backup ]; then
    shift
    # Restic 0.17+ distinguishes a missing repository from other failures.
    status=0
    /usr/bin/restic cat config >/dev/null || status=$?
    case "$status" in
        0) ;;
        10) /usr/bin/restic init ;;
        *) exit "$status" ;;
    esac
    exec /usr/bin/restic backup \
        --exclude-caches \
        --files-from-verbatim "$job_directory/restic.paths" \
        --exclude-file "$job_directory/restic.excludes" "$@"
fi
# Other restic commands use the same runtime cache.
exec /usr/bin/restic "$@"
