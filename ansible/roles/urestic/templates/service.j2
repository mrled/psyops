# Managed by Ansible: urestic
[Unit]
Description=Restic backup for {{ urestic_user }} ({{ urestic_job.name }})
{% for path, options in urestic_job.paths.items() %}
{% if options is mapping and options.mountpoint | default(false) %}
ConditionPathIsMountPoint={{ path }}
{% endif %}
{% endfor %}

[Service]
Type=oneshot
UMask=0077
Environment="HOME={{ urestic_home }}"
ExecStart={{ urestic_home }}/.local/bin/uresticjob "{{ urestic_job_directory }}" backup
TimeoutStartSec=infinity
NoNewPrivileges=true
